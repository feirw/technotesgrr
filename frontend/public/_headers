# Inline προβολή PDF στον browser (όχι forced download) — Netlify
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

/pdfs/*
  Content-Disposition: inline
  X-Frame-Options: SAMEORIGIN

# Vite build output — repeat visits
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Favicon / manifest — μην «κολλάει» παλιό εικονίδιο στο CDN/browser
/favicon.ico
  Cache-Control: public, max-age=0, must-revalidate
/favicon.png
  Cache-Control: public, max-age=0, must-revalidate
/apple-touch-icon.png
  Cache-Control: public, max-age=0, must-revalidate
/site.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

# Runtime env + HTML shell: always revalidate to avoid stale backend URLs/chunk manifests
/env.js
  Cache-Control: no-store
/index.html
  Cache-Control: no-cache, max-age=0, must-revalidate
