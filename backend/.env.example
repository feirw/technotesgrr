DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
PORT=8001
ENV=production
DB_POOL_MIN=1
DB_POOL_MAX=20
CORS_ORIGINS=https://technotesgr.gr,https://www.technotesgr.gr
