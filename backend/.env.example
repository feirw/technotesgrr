DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
# AI Corrector: optional override (defaults to GEMINI_MODEL)
# AI_MODEL=gemini-2.5-flash
CORRECTOR_MAX_OUTPUT_TOKENS=1500
CORRECTOR_OCR_MAX_OUTPUT_TOKENS=2048
CORRECTOR_CONTEXT_MAX_CHARS=14000
CORRECTOR_CONTEXT_TOP_K=8
PORT=8001
ENV=production
DB_POOL_MIN=1
DB_POOL_MAX=20
# Επιπλέον origins (κόμμα-διαχωρισμένα). Το server.py ήδη επιτρέπει .gr/.com + regex· βάλε εδώ staging/preview αν χρειάζεται.
CORS_ORIGINS=https://technotesgr.gr,https://www.technotesgr.gr,https://technotesgr.com,https://www.technotesgr.com
# Set to true only for emergency diagnostics; production should normally be false.
ALLOW_START_WITHOUT_DB=false
